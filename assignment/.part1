using System;

namespace VehicleHierarchyApp
{
    // Base Class
    public class Vehicle
    {
        public string Brand { get; set; }
        public int Year { get; set; }

        // Constructor
        public Vehicle(string brand, int year)
        {
            Brand = brand;
            Year = year;
        }

        // Start Method
        public virtual void Start()
        {
            Console.WriteLine($"{Year} {Brand} vehicle engine started.");
        }
    }

    // Derived Class: Car
    public class Car : Vehicle
    {
        public int NumberOfDoors { get; set; }

        // Constructor using base(...)
        public Car(string brand, int year, int numberOfDoors) : base(brand, year)
        {
            NumberOfDoors = numberOfDoors;
        }

        public override void Start()
        {
            Console.WriteLine($"Car ({Brand}, {Year}, {NumberOfDoors} doors) started.");
        }
    }

    // Derived Class: Bus
    public class Bus : Vehicle
    {
        public int Capacity { get; set; }

        // Constructor using base(...)
        public Bus(string brand, int year, int capacity) : base(brand, year)
        {
            Capacity = capacity;
        }

        public override void Start()
        {
            Console.WriteLine($"Bus ({Brand}, {Year}, Capacity: {Capacity} passengers) started.");
        }
    }

    // Derived Class: Motorcycle
    public class Motorcycle : Vehicle
    {
        public bool HasSidecar { get; set; }

        // Constructor using base(...)
        public Motorcycle(string brand, int year, bool hasSidecar) : base(brand, year)
        {
            HasSidecar = hasSidecar;
        }

        public override void Start()
        {
            string sidecarInfo = HasSidecar ? "with sidecar" : "without sidecar";
            Console.WriteLine($"Motorcycle ({Brand}, {Year}, {sidecarInfo}) started.");
        }
    }

    class Program
    {
        static void Main(string[] args)
        {
            Console.WriteLine("=== Vehicle Hierarchy Demo ===\n");

            // Create objects of each derived class
            Car myCar = new Car("Toyota", 2022, 4);
            Bus myBus = new Bus("Mercedes-Benz", 2020, 50);
            Motorcycle myMotorcycle = new Motorcycle("Yamaha", 2023, false);

            // Call Start() method for each object
            myCar.Start();
            myBus.Start();
            myMotorcycle.Start();
        }
    }
}
